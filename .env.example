# ─────────────────────────────────────────────────────────────────────────────
# AeroRF — environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in your own values.
#   cp .env.example .env          (Linux/macOS)
#   copy .env.example .env        (Windows)
#
# ⚠  .env is git-ignored and MUST NOT be committed.
# ⚠  These values live on the BACKEND only. They are never sent to the
#    browser, never logged, and never returned by any API endpoint.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=AeroRF
ENVIRONMENT=development
DEBUG=false

# URL prefix for the REST API. The frontend proxies /api to the backend.
API_PREFIX=/api/v1

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=127.0.0.1

# AeroRF listens on 8010, not the usual 8000. On this machine 8000 is taken by
# the sibling project `rni-app-4.0`; running here would collide with it and
# the frontend would end up proxying to the wrong application.
PORT=8010

# Port for the Vite dev server. `start.bat` uses this; it is only read when
# you run `npm run dev` by hand from the frontend/ directory.
VITE_PORT=5199

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite is the default and needs no setup.
DATABASE_URL=sqlite:///./aerorf.db

# For PostgreSQL (see AERORF_ARCHITECTURE.md for the PostGIS migration):
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aerorf
# Set SQL_ECHO=true to log every SQL statement.
SQL_ECHO=false

# ─── OpenSky Network (OAuth2 client credentials) ─────────────────────────────
# Get these from your OpenSky account → Account page → create an API client.
#
# They are OPTIONAL. OpenSky serves /states/all to anonymous callers from
# a 400-credit daily pool (verified 2026-09-25), so AeroRF works for live
# traffic out of the box. What needs credentials:
#
#   /flights/*   historical flight search        -> 403 anonymous
#   /tracks/*    historical trajectories         -> empty anonymous
#   /states/all  live traffic                    -> OK, 400 credits/day
#
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Allow the anonymous /states/all path. Set to false to require credentials
# for every flight call.
OPENSKY_ALLOW_ANONYMOUS=true

# OpenSky's auth server and API root. Change only for a self-hosted proxy.
OPENSKY_BASE_URL=https://opensky-network.org

# Renew the access token this many seconds before it expires.
OPENSKY_TOKEN_MARGIN_S=60

# Outbound request timeout, seconds.
OPENSKY_TIMEOUT_S=30

# ─── Cache and credit control ────────────────────────────────────────────────
# OpenSky bills /states, /tracks and /flights from three SEPARATE credit
# pools. These TTLs are deliberately different: live state vectors go stale
# in seconds, historical tracks in minutes.
CACHE_TTL_STATES_S=10
CACHE_TTL_TRACKS_S=300
CACHE_TTL_FLIGHTS_S=300

# When OpenSky answers 429, AeroRF stops calling for a while, starting at
# this many seconds and doubling up to the maximum.
OPENSKY_BACKOFF_BASE_S=30
OPENSKY_BACKOFF_MAX_S=900

# ─── Live tracking ───────────────────────────────────────────────────────────
# How often the live feed polls OpenSky, in seconds. Do not lower this
# aggressively: each poll costs credits, and below ~5 s OpenSky will
# answer 429.
LIVE_POLL_INTERVAL_S=10

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Leave empty to log to stdout only. Set a path to also write a rotating file.
LOG_FILE=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Both hosts are listed for
# VITE_PORT because Vite may bind IPv6 (`::1`) and browsers treat
# http://localhost and http://127.0.0.1 as different origins.
CORS_ORIGINS=http://localhost:5199,http://127.0.0.1:5199,http://[::1]:5199
